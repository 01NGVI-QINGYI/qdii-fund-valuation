{
  "name": "qdii-desk",
  "version": "1.0.0",
  "private": true,
  "description": "美股基金估值宝 — 基于持仓穿透的 QDII / 美股基金实时估值工具",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build-site.mjs",
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:d1:migrate:local": "wrangler d1 migrations apply qdii-fund-valuation-data --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply qdii-fund-valuation-data --remote",
    "selftest": "node test/selftest.mjs",
    "uitest": "node tools/ui-flow.mjs"
  },
  "keywords": [
    "qdii",
    "fund",
    "valuation",
    "eastmoney",
    "tencent",
    "sina"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
